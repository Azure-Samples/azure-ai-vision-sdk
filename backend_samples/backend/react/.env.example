# ---------------------------------------------------------------------------
# Session token storage
# ---------------------------------------------------------------------------
# Session token storage TTL (seconds)
SESSION_TOKEN_TTL=600
# JWKS URL used to validate Face session tokens (defaults to public cloud)
# SESSION_TOKEN_PUB_KEYS_URL=https://api.cognitive.microsoft.com/configurations/sts/keys

# Face API version used when creating / querying liveness sessions
FACE_API_VERSION=v1.2

# ---------------------------------------------------------------------------
# Redis (Azure Entra-auth in prod; local dev uses USE_LOCAL_REDIS=true)
# ---------------------------------------------------------------------------
USE_LOCAL_REDIS=true
REDIS_HOSTNAME=
REDIS_PORT=6380

# Certificate store TTL (seconds, default 7 days) + max accepted cert size (bytes)
CERT_TTL=604800
MAX_CERT_SIZE=10240

# ---------------------------------------------------------------------------
# iOS App Attest (TeamID.BundleID)
# ---------------------------------------------------------------------------
# The iOS sample's bundle id is com.microsoft.azurevisionliveness, so this is
# e.g. ABCDE12345.com.microsoft.azurevisionliveness (your Team ID + that bundle id).
IOS_APP_ID=

# iOS App Clip appID (TeamID.BundleID.Clip) for the AASA appclips section (optional)
IOS_APP_CLIP_ID=

# ---------------------------------------------------------------------------
# Android Play Integrity
# ---------------------------------------------------------------------------
# Defaults to the Android sample's applicationId so /.well-known/assetlinks.json
# matches the sample out of the box.
ANDROID_PACKAGE_NAME=
# Service account JSON (serialized as a single-line string) used to call the
# Play Integrity API. Secret — never surfaced to the browser.
GOOGLE_SERVICE_ACCOUNT_JSON=
ALLOW_DEVICE_INTEGRITY=
ALLOW_BASIC_INTEGRITY=
# Degraded mode: accept Android registration on the hardware Key Attestation chain
# alone when Google is offline (HTTP 5xx/unreachable) or quota is exceeded (HTTP 429),
# and the revocation list can't be fetched. A malformed/bad token (HTTP 4xx) never
# falls back. Such a cert is trusted only by its own session. Set to true to enable.
ALLOW_ANDROID_ATTESTATION_WHEN_GOOGLE_UNAVAILABLE=

# ---------------------------------------------------------------------------
# Universal Link / App Link binding (served at /.well-known)
# ---------------------------------------------------------------------------
# iOS appID (TeamID.BundleID) written into the AASA appIDs. For legacy reasons
# this can differ from the App Attest IOS_APP_ID above; leave unset to reuse
# IOS_APP_ID.
IOS_APPLINK_APP_ID=
# Android signing-cert SHA-256 fingerprints (comma or space separated)
ANDROID_SHA256_CERT_FINGERPRINTS=
# Universal/App Link path pattern (default /native*)
APPLINK_PATH=/native*
# Store links shown on the fallback landing page (optional).
# On iOS, IOS_APP_STORE_URL doubles as the App Clip URL: the landing page
# appends `?s=<sessionId>` to it so the App Clip receives the session on launch.
IOS_APP_STORE_URL=
ANDROID_PLAY_STORE_URL=

# Loosens iOS aaguid + Android appRecognition policy for dev builds
DEBUG_MODE=false

# ---------------------------------------------------------------------------
# Optional telemetry / fraud-risk (not required to run the sample)
# ---------------------------------------------------------------------------
# Application Insights connection string for request / dependency telemetry
# APPLICATIONINSIGHTS_CONNECTION_STRING=
# iOS DeviceCheck key for the (optional, not-wired) App Attest risk metric
# IOS_DEVICECHECK_PRIVATE_KEY=
# IOS_DEVICECHECK_KEY_ID=
