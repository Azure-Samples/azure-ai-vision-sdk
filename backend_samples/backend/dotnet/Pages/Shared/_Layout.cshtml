<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    @if (ViewData["SmartBanner"] is string smartBanner && !string.IsNullOrWhiteSpace(smartBanner))
    {
        <meta name="apple-itunes-app" content="@smartBanner" />
    }
    <title>@ViewData["Title"] — Face Liveness Attestation Backend</title>
    <link rel="stylesheet" href="/site.css" />
</head>
<body>
    <main>
        @RenderBody()
    </main>
</body>
</html>
