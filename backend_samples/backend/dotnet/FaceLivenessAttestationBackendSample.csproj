<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>FaceLivenessAttestationBackendSample</RootNamespace>
    <AssemblyName>FaceLivenessAttestationBackendSample</AssemblyName>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <UserSecretsId>face-liveness-attestation-backend-sample</UserSecretsId>

    <!-- The web project lives at the folder root; keep the sibling test and
         deployment folders out of its compilation. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**;deployment\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="StackExchange.Redis" Version="3.1.31" />
    <PackageReference Include="Microsoft.Azure.StackExchangeRedis" Version="3.3.1" />
    <PackageReference Include="Microsoft.ApplicationInsights.AspNetCore" Version="3.1.2" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\library\dotnet\AzureAIVisionFaceDeviceAttestation\src\Azure.AI.Vision.Face.DeviceAttestation.csproj" />
  </ItemGroup>

</Project>
