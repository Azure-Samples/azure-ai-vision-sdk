<?xml version="1.0" encoding="utf-8"?>
<!--
  Local NuGet configuration for the .NET backend sample.
  The repository root NuGet.config clears all sources down to a private feed;
  this public sample restores its dependencies from nuget.org instead.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
