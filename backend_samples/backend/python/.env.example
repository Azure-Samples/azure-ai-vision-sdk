# --- Store selection ---
# Zero-dependency local run (no Redis needed): set this to true.
USE_MEMORY_STORE=true
# Or use Redis locally instead (USE_MEMORY_STORE must be unset/false):
USE_LOCAL_REDIS=false
# Azure Managed Redis (prod; Entra/Managed Identity auth):
REDIS_HOSTNAME=
REDIS_PORT=6380

# --- Face API ---
# API version used for the liveness-session REST calls (default v1.2).
FACE_API_VERSION=v1.2
SESSION_TOKEN_TTL=600

# --- Certificate store ---
CERT_TTL=604800
MAX_CERT_SIZE=10240

# --- iOS App Attest (TeamID.BundleID) ---
IOS_APP_ID=
# App Clip appID (TeamID.BundleID.Clip) for the AASA appclips section (optional)
IOS_APP_CLIP_ID=
# AASA appID for Universal Links (falls back to IOS_APP_ID when unset)
IOS_APPLINK_APP_ID=

# --- Android Play Integrity ---
# Defaults to the Android sample's applicationId so assetlinks matches out of the box.
ANDROID_PACKAGE_NAME=com.microsoft.azurevisionliveness
GOOGLE_SERVICE_ACCOUNT_JSON=
ALLOW_DEVICE_INTEGRITY=
ALLOW_BASIC_INTEGRITY=
# Allow Android attestation on hardware Key Attestation alone when the Play
# Integrity API is unavailable / quota-exceeded (default false = fail closed).
ALLOW_ANDROID_ATTESTATION_WHEN_GOOGLE_UNAVAILABLE=
# --- Universal Link / App Link binding (served at /.well-known) ---
ANDROID_SHA256_CERT_FINGERPRINTS=
APPLINK_PATH=/native*
IOS_APP_STORE_URL=
ANDROID_PLAY_STORE_URL=

# --- Debug / telemetry ---
# Loosens iOS AAGUID + Android integrity policy for dev builds.
DEBUG_MODE=false
APPLICATIONINSIGHTS_CONNECTION_STRING=
