source 'https://rubygems.org'

# You may use http://rbenv.org/ or https://rvm.io/ to install and use this version
ruby ">= 2.6.10"

gem 'bundler', '>= 2.0.0'

# Exclude problematic versions of cocoapods and activesupport that causes build failures.
gem 'cocoapods', '>= 1.13', '!= 1.15.0', '!= 1.15.1'
gem 'activesupport', '>= 6.1.7.5', '!= 7.1.0'
gem 'xcodeproj', '< 1.26.0'

# concurrent-ruby < 1.3.4 (the upstream React Native template default) pinned this
# below the fix for CVE-2026-54904 (High), CVE-2026-54905 and CVE-2026-54906, all
# patched in 1.3.7 -- require the patched release. That cap also masked an old-
# ActiveSupport "uninitialized constant Logger" build failure; `gem 'logger'` below
# guards that directly, so no version ceiling is needed.
gem 'concurrent-ruby', '>= 1.3.7'
gem 'logger'
